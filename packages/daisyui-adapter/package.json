{
	"name": "@kodaicoder/shadcn-svelte-daisyui-adapter",
	"version": "0.3.0",
	"description": "Generate a shadcn-svelte token set from a daisyUI v5 theme, at build time, with no daisyUI runtime dependency.",
	"license": "MIT",
	"type": "module",
	"bin": {
		"daisyui-adapter": "cli/init.mjs"
	},
	"exports": {
		".": {
			"default": "./dist/index.mjs"
		},
		"./map": "./dist/map.mjs",
		"./ramp": "./dist/ramp.mjs"
	},
	"files": [
		"dist",
		"cli",
		"component-fix.mjs",
		"targets.mjs",
		"CHANGELOG.md"
	],
	"keywords": [
		"daisyui",
		"shadcn-svelte",
		"sveltekit",
		"tailwindcss",
		"theme"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/kodaicoder/shadcn-svelte-daisyui-adapter.git",
		"directory": "packages/daisyui-adapter"
	},
	"engines": {
		"node": ">=20"
	},
	"publishConfig": {
		"access": "public"
	}
}
